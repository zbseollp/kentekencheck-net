---
import BaseLayout from "./BaseLayout.astro";
import KentekenForm from "../components/KentekenForm.astro";
import { POPULAR_CHECKS } from "../lib/site";

interface Props {
  title: string;
  description: string;
  heading: string;
  subheading?: string;
  canonical?: string;
  schema?: object | object[];
}

const { title, description, heading, subheading, canonical, schema } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema}>
  <!-- Dark hero with form -->
  <section class="check-hero">
    <div class="check-hero-inner">
      <div class="check-hero-text">
        <h1>{heading}</h1>
        {subheading && <p class="check-sub">{subheading}</p>}
      </div>
      <div class="check-hero-form">
        <KentekenForm variant="hero" />
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <div class="kc-trust-bar">
    <span>✓ Officiele RDW-bron</span>
    <span>✓ Direct resultaat</span>
    <span>✓ Volledig anoniem</span>
  </div>

  <!-- Content -->
  <div class="check-body">
    <div class="check-content">
      <article class="kc-prose">
        <slot />
      </article>

      <!-- Inline form mid-page -->
      <div class="check-mid-form">
        <p class="check-mid-form-label">Direct controleren?</p>
        <KentekenForm variant="inline" />
      </div>

      <!-- Mobile: populaire checks (sidebar verborgen op mobile) -->
      <div class="check-mobile-checks">
        <p class="check-mobile-checks-title">Andere checks</p>
        <ul>
          {POPULAR_CHECKS.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <aside class="check-sidebar">
      <div class="check-sidebar-box">
        <p class="check-sidebar-title">Direct controleren</p>
        <KentekenForm variant="inline" />
        <p class="check-sidebar-title" style="margin-top: 1.5rem;">Populaire checks</p>
        <ul>
          {POPULAR_CHECKS.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .check-hero {
    background: var(--kc-black);
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(255,255,255,0.015) 0px,
      rgba(255,255,255,0.015) 1px,
      transparent 1px,
      transparent 20px
    );
    padding: clamp(2.5rem, 6vw, 4.5rem) 1.25rem;
    color: #fff;
  }

  .check-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
  }

  .check-hero-text h1 {
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .check-sub {
    color: #a0a0a8;
    font-size: 1.05rem;
    max-width: 46ch;
    line-height: 1.65;
  }

  .check-hero-form {
    display: flex;
    justify-content: center;
  }

  .kc-trust-bar {
    background: var(--kc-yellow);
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    flex-wrap: wrap;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--kc-black);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .check-body {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.25rem;
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    align-items: stretch;
  }

  .check-content {
    align-self: start;
  }

  .check-mid-form {
    margin: 2.5rem 0;
    background: var(--kc-grey-50);
    border-radius: 14px;
    padding: 2rem;
    border: 1px solid var(--kc-grey-100);
  }

  .check-mid-form-label {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--kc-black);
    margin-bottom: 1rem;
  }

  .check-sidebar-box {
    background: var(--kc-black);
    border-radius: 12px;
    padding: 1.5rem;
    position: sticky;
    top: 84px;
  }

  .check-sidebar-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--kc-yellow);
    margin-bottom: 1rem;
  }

  /* Sidebar form: override inline form for dark background */
  .check-sidebar-box .kc-form-inline { max-width: 100%; }
  .check-sidebar-box .kc-plate-wrap { border-color: rgba(255,255,255,0.15); }
  .check-sidebar-box .kc-btn-controleer {
    background: var(--kc-yellow);
    color: var(--kc-black);
  }
  .check-sidebar-box .kc-btn-controleer:hover { background: var(--kc-yellow-dark); }

  .check-sidebar-box ul { list-style: none; }
  .check-sidebar-box li { border-bottom: 1px solid rgba(255,255,255,0.06); }
  .check-sidebar-box a {
    display: block;
    color: #c0c0c8;
    text-decoration: none;
    font-size: 0.875rem;
    padding: 0.55rem 0;
    transition: color 0.15s;
  }
  .check-sidebar-box a:hover { color: var(--kc-yellow); }

  .check-mobile-checks { display: none; }

  .check-mobile-checks-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--kc-yellow);
    margin-bottom: 0.75rem;
  }

  .check-mobile-checks ul { list-style: none; }
  .check-mobile-checks li { border-bottom: 1px solid var(--kc-grey-100); }
  .check-mobile-checks a {
    display: block;
    color: var(--kc-ink);
    text-decoration: none;
    font-size: 0.875rem;
    padding: 0.5rem 0;
    transition: color 0.15s;
  }
  .check-mobile-checks a:hover { color: var(--kc-blue); }

  @media (max-width: 900px) {
    .check-hero-inner { grid-template-columns: 1fr; }
    .check-body { grid-template-columns: 1fr; }
    .check-sidebar { display: none; }
    .check-mobile-checks {
      display: block;
      margin-top: 2rem;
      background: var(--kc-grey-50);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      border: 1px solid var(--kc-grey-100);
    }
  }
</style>
