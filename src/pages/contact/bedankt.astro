---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Bedankt voor je bericht | Kentekencheck.net"
  description="We hebben je bericht ontvangen en reageren zo snel mogelijk."
  noindex={true}
>
  <section class="thanks-section">
    <div class="thanks-inner">
      <div class="thanks-icon" aria-hidden="true">✓</div>
      <h1>Bedankt voor je bericht!</h1>
      <p>We hebben je bericht ontvangen en reageren zo snel mogelijk, doorgaans binnen 2 werkdagen.</p>
      <a href="/" class="back-btn">← Terug naar de homepagina</a>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks-section {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.25rem;
    background: var(--kc-grey-50);
  }

  .thanks-inner {
    text-align: center;
    max-width: 500px;
  }

  .thanks-icon {
    display: inline-flex;
    width: 72px;
    height: 72px;
    background: var(--kc-yellow);
    color: var(--kc-black);
    font-size: 2rem;
    font-weight: 900;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 900;
    color: var(--kc-black);
    margin-bottom: 1rem;
  }

  p {
    color: #55555d;
    font-size: 1rem;
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .back-btn {
    display: inline-block;
    background: var(--kc-black);
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    transition: background 0.15s;
  }

  .back-btn:hover { background: var(--kc-ink); }
</style>
