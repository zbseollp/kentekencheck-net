---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../lib/site";

const { kenteken } = Astro.params;
const raw = (kenteken ?? "").toUpperCase().replace(/[^A-Z0-9]/g, "");

if (!raw || raw.length < 4) {
  return Astro.redirect("/");
}

// Alle gratis RDW datasets parallel ophalen
type RdwRecord = Record<string, string>;

let voertuig: RdwRecord | null = null;
let brandstofData: RdwRecord | null = null;
let carrosserieData: RdwRecord | null = null;
let gebrekenData: RdwRecord[] = [];
let terugroepData: RdwRecord[] = [];
let fout = false;

try {
  const [vRes, bRes, cRes, gRes, tRes] = await Promise.all([
    fetch(`https://opendata.rdw.nl/resource/m9d7-ebf2.json?kenteken=${raw}&$limit=1`),
    fetch(`https://opendata.rdw.nl/resource/8ys7-d773.json?kenteken=${raw}&$limit=5`),
    fetch(`https://opendata.rdw.nl/resource/vezc-m2t6.json?kenteken=${raw}&$limit=1`),
    fetch(`https://opendata.rdw.nl/resource/a34c-vvps.json?kenteken=${raw}&$limit=20`),
    fetch(`https://opendata.rdw.nl/resource/t49b-isb7.json?kenteken=${raw}&$limit=10`),
  ]);

  if (vRes.ok) { const d = await vRes.json() as RdwRecord[]; voertuig = d[0] ?? null; }
  if (bRes.ok) { const d = await bRes.json() as RdwRecord[]; brandstofData = d[0] ?? null; }
  if (cRes.ok) { const d = await cRes.json() as RdwRecord[]; carrosserieData = d[0] ?? null; }
  if (gRes.ok) { gebrekenData = await gRes.json() as RdwRecord[]; }
  if (tRes.ok) { terugroepData = await tRes.json() as RdwRecord[]; }
} catch {
  fout = true;
}

// Gebrek omschrijvingen ophalen
let gebrekOmschrijvingen: Record<string, string> = {};
if (gebrekenData.length > 0) {
  const ids = [...new Set(gebrekenData.map(g => g.gebrek_identificatie).filter(Boolean))];
  try {
    const results = await Promise.all(
      ids.map(id => fetch(`https://opendata.rdw.nl/resource/hx2c-gt7k.json?gebrek_identificatie=${id}&$limit=1`).then(r => r.json()) as Promise<RdwRecord[]>)
    );
    ids.forEach((id, i) => {
      const rec = results[i]?.[0];
      if (rec?.gebrek_omschrijving) gebrekOmschrijvingen[id] = rec.gebrek_omschrijving;
    });
  } catch {}
}

// Helpers
function formatDatum(d: string): string {
  if (!d || d.length !== 8) return d ?? "–";
  return `${d.slice(6, 8)}-${d.slice(4, 6)}-${d.slice(0, 4)}`;
}

function formatKenteken(k: string): string {
  const patterns = [
    /^([A-Z]{2})(\d{2})([A-Z]{2})$/,/^(\d{2})([A-Z]{2})(\d{2})$/,
    /^(\d{2})(\d{2})([A-Z]{2})$/,/^([A-Z]{2})(\d{2})(\d{2})$/,
    /^([A-Z]{2})([A-Z]{2})(\d{2})$/,/^(\d{2})([A-Z]{2})([A-Z]{2})$/,
    /^(\d{1})([A-Z]{3})(\d{2})$/,/^(\d{2})([A-Z]{3})(\d{1})$/,
    /^([A-Z]{1})(\d{3})([A-Z]{2})$/,/^([A-Z]{2})(\d{3})([A-Z]{1})$/,
    /^(\d{3})([A-Z]{2})(\d{1})$/,/^(\d{1})([A-Z]{2})(\d{3})$/,
    /^([A-Z]{3})(\d{2})([A-Z]{1})$/,/^([A-Z]{1})(\d{2})([A-Z]{3})$/,
  ];
  for (const p of patterns) {
    const m = k.match(p);
    if (m) return `${m[1]}-${m[2]}-${m[3]}`;
  }
  return k;
}

function cap(s: string): string {
  if (!s) return "–";
  return s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();
}

function euroNorm(code: string): string {
  const map: Record<string, string> = {
    "0": "Geen", "1": "Euro 1", "2": "Euro 2", "3": "Euro 3",
    "4": "Euro 4", "5": "Euro 5", "6": "Euro 6", "7": "Euro 6d",
    "8": "Euro 6d-temp",
  };
  return map[code] ?? `Euro ${code}`;
}

function tellerOordeelLabel(code: string, oordeel: string): string {
  const map: Record<string, string> = {
    "00": "Logisch", "01": "Onlogisch", "02": "Geen opgave",
    "03": "Verdacht", "04": "Onbekend", "05": "Geen oordeel",
    "06": "Logisch (import)",
  };
  return map[code] ?? oordeel ?? "–";
}

const kentekenFormatted = formatKenteken(raw);
const isGevonden = !!voertuig;

// kentekencheck.nu rapport URLs
const kcBase = `https://www.kentekencheck.nu/rapport/opvragen/?k=${raw}`;
const kcLinks = {
  schadeverleden:    `${kcBase}&r[]=schadeverleden`,
  eigenaren:         `${kcBase}&r[]=eigenarenhistorie`,
  kilometerstand:    `${kcBase}&r[]=kilometerstand_check`,
  dagwaarde:         `${kcBase}&r[]=waardetaxatie`,
  milieu:            `${kcBase}&r[]=milieurapport`,
  autokosten:        `${kcBase}&r[]=autokosten_rapport`,
  compleet:          `https://www.kentekencheck.nu/rapport/opvragen/?k=${raw}&v=&r[]=schadeverleden`,
};

// Extracteer alle velden
const merk        = voertuig?.merk ?? "–";
const model       = voertuig?.handelsbenaming ?? "–";
const bouwjaar    = voertuig?.datum_eerste_toelating?.slice(0, 4) ?? "–";
const kleur       = cap(voertuig?.eerste_kleur ?? "");
const kleur2      = voertuig?.tweede_kleur && voertuig.tweede_kleur !== "Niet geregistreerd" ? cap(voertuig.tweede_kleur) : null;
const soort       = voertuig?.voertuigsoort ?? "–";
const inrichting  = cap(voertuig?.inrichting ?? "");
const deuren      = voertuig?.aantal_deuren ?? "–";
const zitplaatsen = voertuig?.aantal_zitplaatsen ?? "–";
const cilinderinhoud = voertuig?.cilinderinhoud ? `${voertuig.cilinderinhoud} cc` : "–";
const cilinders   = voertuig?.aantal_cilinders ?? "–";
const massaLedig  = voertuig?.massa_ledig_voertuig && voertuig.massa_ledig_voertuig !== "0" ? `${voertuig.massa_ledig_voertuig} kg` : "–";
const massaRijklaar = voertuig?.massa_rijklaar && voertuig.massa_rijklaar !== "0" ? `${voertuig.massa_rijklaar} kg` : "–";
const wielbasis   = voertuig?.wielbasis && voertuig.wielbasis !== "0" ? `${voertuig.wielbasis} cm` : "–";
const euroCateg   = voertuig?.europese_voertuigcategorie ?? "–";
const brutosBpm   = voertuig?.bruto_bpm && voertuig.bruto_bpm !== "0" ? `€ ${parseInt(voertuig.bruto_bpm).toLocaleString("nl-NL")}` : "–";

// APK & status
const apkDatum     = voertuig?.vervaldatum_apk ? formatDatum(voertuig.vervaldatum_apk) : "–";
const apkRaw       = voertuig?.vervaldatum_apk ?? "";
const apkVerleden  = apkRaw && apkRaw < new Date().toISOString().replace(/-/g,"").slice(0,8);
const tenaamDatum  = voertuig?.datum_tenaamstelling ? formatDatum(voertuig.datum_tenaamstelling) : "–";
const eersteNL     = voertuig?.datum_eerste_tenaamstelling_in_nederland ? formatDatum(voertuig.datum_eerste_tenaamstelling_in_nederland) : "–";
const verzekerd    = voertuig?.wam_verzekerd ?? "–";
const terugroep    = voertuig?.openstaande_terugroepactie_indicator ?? "–";
const tellerCode   = voertuig?.code_toelichting_tellerstandoordeel ?? "";
const tellerOordeel = tellerOordeelLabel(tellerCode, voertuig?.tellerstandoordeel ?? "");
const jaarTeller   = voertuig?.jaar_laatste_registratie_tellerstand ?? "–";
const tenaamMogelijk = voertuig?.tenaamstellen_mogelijk ?? "–";
const exportIndicator = voertuig?.export_indicator ?? "–";
const taxi        = voertuig?.taxi_indicator ?? "–";

// Brandstof & emissie
const brandstof   = brandstofData?.brandstof_omschrijving ?? "–";
const emissiecode = brandstofData?.emissiecode_omschrijving;
const euroLabel   = emissiecode ? euroNorm(emissiecode) : "–";

// Carrosserie
const carrosserieType = carrosserieData?.type_carrosserie_europese_omschrijving ?? "";

const title = isGevonden
  ? `Kenteken ${kentekenFormatted} – ${merk} ${model} (${bouwjaar}) | Kentekencheck.net`
  : `Kenteken ${kentekenFormatted} – Gratis RDW check | Kentekencheck.net`;

const description = isGevonden
  ? `Gratis RDW-data voor ${kentekenFormatted}: ${merk} ${model} ${bouwjaar}, ${kleur}, APK t/m ${apkDatum}, ${brandstof}. Bekijk alle voertuiggegevens direct.`
  : `RDW-informatie opvragen voor kenteken ${kentekenFormatted}. Gratis voertuigdata via Kentekencheck.net.`;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: `${SITE.url}/kenteken/${raw}/`,
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- Hero -->
  <div class="kt-hero">
    <div class="kt-hero-inner">
      <div class="kt-plate-display" aria-label={`Kenteken ${kentekenFormatted}`}>
        <div class="kt-plate-flag">
          <svg width="22" height="34" viewBox="0 0 22 34" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="22" height="34" rx="3" fill="#003399"/>
            <text x="11" y="10" text-anchor="middle" font-size="7" fill="#f5c518" font-family="sans-serif" font-weight="bold">★</text>
            <text x="11" y="26" text-anchor="middle" font-size="9" fill="white" font-family="Arial, sans-serif" font-weight="bold">NL</text>
          </svg>
        </div>
        <span class="kt-plate-num">{kentekenFormatted}</span>
      </div>

      <div class="kt-hero-info">
        <h1>Kenteken {kentekenFormatted}</h1>
        {isGevonden ? (
          <>
            <p class="kt-hero-sub">
              {merk} {model}
              {` · ${soort}`}
              {carrosserieType ? ` · ${carrosserieType}` : inrichting !== "–" ? ` · ${inrichting}` : ""}
              {` · ${bouwjaar} · ${kleur}`}
              {kleur2 ? ` / ${kleur2}` : ""}
            </p>
            <div class="kt-status-pills">
              <span class={`kt-pill ${verzekerd === "Ja" ? "kt-pill--ok" : "kt-pill--warn"}`}>
                WAM {verzekerd === "Ja" ? "verzekerd" : "onverzekerd"}
              </span>
              <span class={`kt-pill ${apkVerleden ? "kt-pill--warn" : "kt-pill--ok"}`}>
                APK {apkVerleden ? "verlopen" : `t/m ${apkDatum}`}
              </span>
              {terugroep === "Ja" && (
                <span class="kt-pill kt-pill--warn">⚠ Terugroepactie</span>
              )}
            </div>
          </>
        ) : (
          <p class="kt-hero-sub">{fout ? "RDW-data tijdelijk niet beschikbaar" : "Niet gevonden in het RDW-register"}</p>
        )}
      </div>
    </div>
  </div>

  <div class="kt-body">
    <div class="kt-container">
      {isGevonden ? (
        <>
          <!-- Voertuiggegevens -->
          <section class="kt-card">
            <h2 class="kt-card-title">Voertuiggegevens</h2>
            <dl class="kt-dl">
              <div class="kt-dl-row"><dt>Merk</dt><dd>{merk}</dd></div>
              <div class="kt-dl-row"><dt>Model</dt><dd>{model}</dd></div>
              <div class="kt-dl-row"><dt>Voertuigsoort</dt><dd>{soort}</dd></div>
              {carrosserieType && <div class="kt-dl-row"><dt>Carrosserie</dt><dd>{carrosserieType}</dd></div>}
              {inrichting !== "–" && !carrosserieType && <div class="kt-dl-row"><dt>Inrichting</dt><dd>{inrichting}</dd></div>}
              <div class="kt-dl-row"><dt>Bouwjaar</dt><dd>{bouwjaar}</dd></div>
              <div class="kt-dl-row"><dt>Kleur</dt><dd>{kleur}{kleur2 ? ` / ${kleur2}` : ""}</dd></div>
              <div class="kt-dl-row"><dt>Deuren</dt><dd>{deuren}</dd></div>
              <div class="kt-dl-row"><dt>Zitplaatsen</dt><dd>{zitplaatsen}</dd></div>
              <div class="kt-dl-row"><dt>EU-categorie</dt><dd>{euroCateg}</dd></div>
              {brutosBpm !== "–" && <div class="kt-dl-row"><dt>Bruto BPM</dt><dd>{brutosBpm}</dd></div>}
            </dl>
          </section>

          <!-- Motor & technisch -->
          <section class="kt-card">
            <h2 class="kt-card-title">Motor &amp; technisch</h2>
            <dl class="kt-dl">
              <div class="kt-dl-row"><dt>Brandstof</dt><dd>{brandstof}</dd></div>
              <div class="kt-dl-row"><dt>Emissieklasse</dt><dd>{euroLabel}</dd></div>
              {cilinders !== "–" && cilinders !== "0" && <div class="kt-dl-row"><dt>Cilinders</dt><dd>{cilinders}</dd></div>}
              {cilinderinhoud !== "–" && <div class="kt-dl-row"><dt>Cilinderinhoud</dt><dd>{cilinderinhoud}</dd></div>}
              {massaLedig !== "–" && <div class="kt-dl-row"><dt>Massa ledig</dt><dd>{massaLedig}</dd></div>}
              {massaRijklaar !== "–" && <div class="kt-dl-row"><dt>Massa rijklaar</dt><dd>{massaRijklaar}</dd></div>}
              {wielbasis !== "–" && <div class="kt-dl-row"><dt>Wielbasis</dt><dd>{wielbasis}</dd></div>}
            </dl>
          </section>

          <!-- Tussentijdse CTA -->
          <section class="kt-card kt-card--full kt-cta-mid">
            <div class="kt-cta-mid-left">
              <p class="kt-cta-mid-label">Meer weten over dit voertuig?</p>
              <a href={kcLinks.compleet} class="kt-cta-btn kt-cta-btn--primary" target="_blank" rel="noopener noreferrer">
                Bestel compleet rapport →
              </a>
            </div>
            <div class="kt-cta-mid-right">
              <a href={kcLinks.schadeverleden} class="kt-cta-pill" target="_blank" rel="noopener noreferrer">🔍 Schadeverleden</a>
              <a href={kcLinks.eigenaren} class="kt-cta-pill" target="_blank" rel="noopener noreferrer">👤 Eigenarenhistorie</a>
              <a href={kcLinks.kilometerstand} class="kt-cta-pill" target="_blank" rel="noopener noreferrer">📏 Kilometerstand</a>
              <a href={kcLinks.dagwaarde} class="kt-cta-pill" target="_blank" rel="noopener noreferrer">💶 Dagwaarde</a>
            </div>
          </section>

          <!-- APK & registratie -->
          <section class="kt-card">
            <h2 class="kt-card-title">APK &amp; registratie</h2>
            <dl class="kt-dl">
              <div class="kt-dl-row">
                <dt>APK geldig tot</dt>
                <dd class={apkVerleden ? "kt-warn" : "kt-ok"}>{apkDatum}</dd>
              </div>
              <div class="kt-dl-row"><dt>Eerste toelating</dt><dd>{bouwjaar}</dd></div>
              <div class="kt-dl-row"><dt>Eerste NL tenaamstelling</dt><dd>{eersteNL}</dd></div>
              <div class="kt-dl-row"><dt>Huidige tenaamstelling</dt><dd>{tenaamDatum}</dd></div>
              <div class="kt-dl-row"><dt>Tellerstandoordeel</dt><dd>{tellerOordeel}</dd></div>
              <div class="kt-dl-row"><dt>Jaar laatste tellerstand</dt><dd>{jaarTeller}</dd></div>
            </dl>
          </section>

          <!-- Status & bijzonderheden -->
          <section class="kt-card">
            <h2 class="kt-card-title">Status &amp; bijzonderheden</h2>
            <dl class="kt-dl">
              <div class="kt-dl-row">
                <dt>WAM verzekerd</dt>
                <dd class={verzekerd === "Ja" ? "kt-ok" : "kt-warn"}>{verzekerd}</dd>
              </div>
              <div class="kt-dl-row">
                <dt>Terugroepactie</dt>
                <dd class={terugroep === "Ja" ? "kt-warn" : "kt-ok"}>{terugroep === "Ja" ? "⚠ Ja" : "Geen"}</dd>
              </div>
              <div class="kt-dl-row">
                <dt>Tenaamstellen mogelijk</dt>
                <dd class={tenaamMogelijk === "Ja" ? "kt-ok" : tenaamMogelijk === "Nee" ? "kt-warn" : ""}>{tenaamMogelijk}</dd>
              </div>
              <div class="kt-dl-row">
                <dt>Export</dt>
                <dd class={exportIndicator === "Ja" ? "kt-warn" : ""}>{exportIndicator}</dd>
              </div>
              <div class="kt-dl-row"><dt>Taxi</dt><dd>{taxi}</dd></div>
            </dl>
          </section>

          <!-- APK keuringsgebreken -->
          {gebrekenData.length > 0 && (
            <section class="kt-card kt-card--full">
              <h2 class="kt-card-title">APK keuringsgebreken</h2>
              <p class="kt-card-sub">Geregistreerde gebreken bij APK-keuringen via RDW</p>
              <div class="kt-gebreken">
                {gebrekenData.map(g => (
                  <div class="kt-gebrek-row">
                    <div class="kt-gebrek-datum">{
                      g.meld_datum_door_keuringsinstantie
                        ? formatDatum(g.meld_datum_door_keuringsinstantie)
                        : "–"
                    }</div>
                    <div class="kt-gebrek-info">
                      <span class="kt-gebrek-omschrijving">
                        {gebrekOmschrijvingen[g.gebrek_identificatie] ?? `Gebrek ${g.gebrek_identificatie}`}
                      </span>
                      <span class="kt-gebrek-soort">{g.soort_erkenning_omschrijving}</span>
                    </div>
                    {parseInt(g.aantal_gebreken_geconstateerd) > 0 && (
                      <div class="kt-gebrek-count">{g.aantal_gebreken_geconstateerd}×</div>
                    )}
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Terugroepacties -->
          {terugroepData.length > 0 && (
            <section class="kt-card kt-card--full kt-card--warn">
              <h2 class="kt-card-title">⚠ Terugroepacties</h2>
              <div class="kt-gebreken">
                {terugroepData.map(t => (
                  <div class="kt-gebrek-row">
                    <div class="kt-gebrek-datum">{t.referentiecode_rdw}</div>
                    <div class="kt-gebrek-info">
                      <span class="kt-gebrek-omschrijving">{t.status}</span>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Compleet rapport CTA -->
          <section class="kt-card kt-card--full kt-cta-compleet">
            <div class="kt-cta-compleet-inner">
              <div class="kt-cta-compleet-text">
                <h2>Compleet rapport voor {kentekenFormatted}</h2>
                <p>Bekijk in één rapport het schadeverleden, de eigenarenhistorie, de kilometerstand, de dagwaarde en meer. Alles over dit voertuig op één plek.</p>
                <ul class="kt-cta-inclusieflijst">
                  <li>✓ Schadeverleden</li>
                  <li>✓ Eigenarenhistorie</li>
                  <li>✓ Kilometerstand check</li>
                  <li>✓ Dagwaarde &amp; inruilwaarde</li>
                  <li>✓ Milieurapport</li>
                  <li>✓ Autokosten rapport</li>
                </ul>
              </div>
              <div class="kt-cta-compleet-action">
                <a href={kcLinks.compleet} class="kt-cta-btn kt-cta-btn--primary" target="_blank" rel="noopener noreferrer">
                  Bestel compleet rapport
                  <span class="kt-cta-arrow">→</span>
                </a>
                <p class="kt-cta-sub">Via kentekencheck.nu · Meteen beschikbaar</p>
              </div>
            </div>
          </section>

          <!-- Losse producten -->
          <section class="kt-card kt-card--full kt-producten">
            <h2 class="kt-card-title">Losse checks voor dit kenteken</h2>
            <div class="kt-producten-grid">
              <a href={kcLinks.schadeverleden} class="kt-product-card" target="_blank" rel="noopener noreferrer">
                <div class="kt-product-icon">🔍</div>
                <div class="kt-product-info">
                  <span class="kt-product-naam">Schadeverleden</span>
                  <span class="kt-product-sub">Bekijk alle schademeldingen</span>
                </div>
                <span class="kt-product-arrow">→</span>
              </a>
              <a href={kcLinks.eigenaren} class="kt-product-card" target="_blank" rel="noopener noreferrer">
                <div class="kt-product-icon">👤</div>
                <div class="kt-product-info">
                  <span class="kt-product-naam">Eigenarenhistorie</span>
                  <span class="kt-product-sub">Hoeveel eigenaren had dit voertuig?</span>
                </div>
                <span class="kt-product-arrow">→</span>
              </a>
              <a href={kcLinks.kilometerstand} class="kt-product-card" target="_blank" rel="noopener noreferrer">
                <div class="kt-product-icon">📏</div>
                <div class="kt-product-info">
                  <span class="kt-product-naam">Kilometerstand check</span>
                  <span class="kt-product-sub">Klopt de kilometerstand?</span>
                </div>
                <span class="kt-product-arrow">→</span>
              </a>
              <a href={kcLinks.dagwaarde} class="kt-product-card" target="_blank" rel="noopener noreferrer">
                <div class="kt-product-icon">💶</div>
                <div class="kt-product-info">
                  <span class="kt-product-naam">Dagwaarde &amp; inruilwaarde</span>
                  <span class="kt-product-sub">Wat is dit voertuig waard?</span>
                </div>
                <span class="kt-product-arrow">→</span>
              </a>
              <a href={kcLinks.milieu} class="kt-product-card" target="_blank" rel="noopener noreferrer">
                <div class="kt-product-icon">🌱</div>
                <div class="kt-product-info">
                  <span class="kt-product-naam">Milieurapport</span>
                  <span class="kt-product-sub">CO₂-uitstoot &amp; emissieklasse</span>
                </div>
                <span class="kt-product-arrow">→</span>
              </a>
              <a href={kcLinks.autokosten} class="kt-product-card" target="_blank" rel="noopener noreferrer">
                <div class="kt-product-icon">🧾</div>
                <div class="kt-product-info">
                  <span class="kt-product-naam">Autokosten rapport</span>
                  <span class="kt-product-sub">Totale kosten van dit voertuig</span>
                </div>
                <span class="kt-product-arrow">→</span>
              </a>
            </div>
          </section>

          <!-- Overige links -->
          <section class="kt-card kt-card--full kt-related">
            <h2 class="kt-card-title">Meer informatie</h2>
