const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Kenteken overschrijven",
  description: "Alles over het overschrijven van een kenteken bij aankoop van een tweedehands auto. Kosten, stappen en wat je nodig hebt.",
