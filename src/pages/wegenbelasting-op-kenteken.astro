  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Wegenbelasting op kenteken",
  description: "Bereken de wegenbelasting via het kenteken. Hoeveel motorrijtuigenbelasting betaal jij per kwartaal?",
