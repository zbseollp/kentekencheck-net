---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Pagina niet gevonden | Kentekencheck.net"
  description="Deze pagina bestaat niet. Ga terug naar de homepagina om een kenteken te controleren."
  noindex={true}
>
  <section class="not-found">
    <div class="not-found-inner">
      <div class="not-found-code">404</div>
      <h1>Pagina niet gevonden</h1>
      <p>De pagina die je zoekt bestaat niet of is verplaatst. Gebruik het formulier hieronder om direct een kenteken te controleren.</p>
      <div class="not-found-links">
        <a href="/" class="btn-primary">← Naar de homepagina</a>
        <a href="/blog/" class="btn-secondary">Naar het blog</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.25rem;
    background: var(--kc-black);
    color: #fff;
  }

  .not-found-inner { text-align: center; max-width: 500px; }

  .not-found-code {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(5rem, 15vw, 9rem);
    color: var(--kc-yellow);
    line-height: 1;
    margin-bottom: 0.5rem;
    letter-spacing: -0.04em;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  p {
    color: #a0a0a8;
    font-size: 1rem;
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .not-found-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    background: var(--kc-yellow);
    color: var(--kc-black);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    transition: background 0.15s;
  }

  .btn-primary:hover { background: var(--kc-yellow-dark); }

  .btn-secondary {
    background: rgba(255,255,255,0.1);
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.15);
    transition: background 0.15s;
  }

  .btn-secondary:hover { background: rgba(255,255,255,0.15); }
</style>
