---
/**
 * Fixed 16:9 thumbnail frame for blog cards and article heroes.
 * Real photos use cover; the site placeholder fills the frame cleanly.
 */
interface Props {
  src: string;
  alt: string;
  eager?: boolean;
  width?: number;
  height?: number;
  variant?: "card-light" | "card-dark" | "hero";
}

const {
  src,
  alt,
  eager = false,
  width = 400,
  height = 225,
  variant = "card-light",
} = Astro.props;

const isPlaceholder =
  src.includes("blog-default") || src.endsWith("/images/blog-default.svg");
---

<div class:list={["blog-thumb", `blog-thumb--${variant}`, { "blog-thumb--placeholder": isPlaceholder }]}>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    class="blog-thumb-img"
  />
</div>

<style>
  .blog-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #1a1a20;
    flex-shrink: 0;
  }

  .blog-thumb--card-light {
    width: calc(100% + 3.5rem);
    margin: -1.75rem -1.75rem 1.25rem;
    border-radius: 12px 12px 0 0;
  }

  .blog-thumb--card-dark {
    width: calc(100% + 3rem);
    margin: -1.5rem -1.5rem 1rem;
    border-radius: 12px 12px 0 0;
  }

  .blog-thumb--hero {
    border-radius: 12px;
    border: 1px solid var(--kc-grey-100, #e8e8ee);
  }

  .blog-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Placeholder art is designed for 16:9 — show it full-frame, not cropped. */
  .blog-thumb--placeholder .blog-thumb-img {
    object-fit: cover;
    object-position: center;
  }
</style>
