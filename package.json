{
  "name": "kentekencheck-net",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:blog": "node scripts/remove-spam-blog.mjs && node scripts/sanitize-blog.mjs && node scripts/validate-blog.mjs",
    "dev": "npm run prepare:blog && astro dev",
    "build": "npm run prepare:blog && astro build",
    "preview": "astro preview",
    "deploy": "npm run build && npx wrangler deploy",
    "astro": "astro"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/montserrat": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^5.18.2",
    "astro-compress": "^2.4.1",
    "tailwindcss": "^4.3.2"
  }
}
