# Payload media (R2). Without these the resolver falls back to the shared
# bucket base below — set the real values in CI so /media/... paths resolve to
# {R2_PUBLIC_URL}/tenants/{PUBLIC_TENANT_SLUG}/{filename}
R2_PUBLIC_URL=https://pub-d4024ad3e57841448e0ee58a19abe46b.r2.dev
PUBLIC_TENANT_SLUG=kentekencheck-net

# REQUIRED in CI / Cloudflare for permanent featured-image sync:
# prepare:blog → sync-featured-images-from-payload writes CMS hero/featured
# URLs into markdown frontmatter before Astro builds. Also used at runtime as
# a fallback when a post still has no image field.
# PAYLOAD_URL=https://payload.10beste.com/api
PAYLOAD_API_KEY=
